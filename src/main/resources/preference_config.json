{
  "configs": [
    {
      "title": "固定随机播放",
      "config": "config.json",
      "preferences": [
        {
          "key": "debug.enable_file_log",
          "type": "switch",
          "title": "开启文件日志",
          "summary": "默认关闭。开启后将调试日志写入插件数据目录的 logs/plugin-debug.log。",
          "default_value": false
        },
        {
          "type": "button",
          "title": "固定随机当前队列",
          "summary": "先洗牌生成固定顺序，再直接重建当前播放队列",
          "arrow_type": "none",
          "on_click": "com.gg.example.MainPlugin.onDeterministicShuffleButtonClick"
        }
      ]
    }
  ]
}
